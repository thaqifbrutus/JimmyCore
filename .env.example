# Postgres connection string. Neon requires the ?sslmode=require suffix.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenRouter — the single credential for all AI calls.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the default AI model.
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: comma-separated list to override the fallback chain.
# AI_FALLBACK_MODELS=model-a:free,model-b:free

# Optional: OpenRouter routing headers. Placeholder defaults in app/config.py.
# OPENROUTER_APP_NAME=JimmyCore
# OPENROUTER_APP_URL=https://your-deployed-url

# Frontend only — the backend URL that frontend.py talks to.
# Defaults to http://localhost:8000 if unset.
JIMMYCORE_API_URL=http://localhost:8000